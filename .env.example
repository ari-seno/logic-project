# ----------------------------------------------------------------------------
# Public Supabase credentials — safe to expose to the browser
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-key>

# ----------------------------------------------------------------------------
# Public site URL — used for redirects and absolute links
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_
# Only import from server code (server components, server actions, route
# handlers). Never expose to the browser.
# Part 1 does not currently require this; included for future use.
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
