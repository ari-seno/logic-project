# Copy to .env.test and fill in real values to run Playwright E2E tests.
# These must point at a dedicated Supabase test project (not production).

NEXT_PUBLIC_SUPABASE_URL=https://<test-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<test-public-anon-key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
